#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h> 


/ {  
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base_layer";
            bindings = < 
            &out OUT_BLE  &bt BT_CLR    &kp 3
            &kp 4    &kp 5    &kp 6
            >;
        };
        extra_layer_1 {
            status = "reserved";
        };
        extra_layer_2 {
            status = "reserved";
        };
    };
 };
